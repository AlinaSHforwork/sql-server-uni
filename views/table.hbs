<html>
<head>
  <title>Table: {{tableName}}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    th, td { border: 1px solid #ccc; padding: 12px; text-align: left; }
    th { background: #f4f4f4; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
    button { padding: 10px 15px; border: none; border-radius: 5px; cursor: pointer; }
    .insert-btn { background: #28a745; color: white; }
    .delete-btn { background: #dc3545; color: white; }
    .search-box { margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px; }
    .pagination { margin-top: 30px; padding: 15px; background: #f8f9fa; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
    .error-msg { color: red; margin-top: 8px; display: none; }
  </style>
</head>
<body>
  <h1>Table: <strong>{{tableName}}</strong></h1>
  <a href="/">← Back to all tables</a>

  <div class="search-box">
    <form action="/table/{{tableName}}" method="GET">
      <input type="text" name="q" value="{{searchTerm}}" placeholder="Search anything in this table...">
      <input type="hidden" name="limit" value="{{limit}}">
      <button type="submit">Search</button>
      {{#if searchTerm}}
        <a href="/table/{{tableName}}?limit={{limit}}"><button type="button">Clear</button></a>
      {{/if}}
    </form>
  </div>

  <h2>Add New Row</h2>
  <div class="form-grid" id="insertForm">
    {{#each columns}}
      {{#unless (eq this.column_name "id")}}
        <div>
          <label><strong>{{this.column_name}}</strong></label><br>
          <input type="text" data-col="{{this.column_name}}">
        </div>
      {{/unless}}
    {{/each}}
    <button type="button" class="insert-btn" style="grid-column: span 2;" onclick="insertRow()">✅ Insert Row</button>
    <p class="error-msg" id="insertError" style="grid-column: span 2;"></p>
  </div>

  <h2>Data ({{totalRows}} total rows)</h2>

  {{#if rows.length}}
    <table id="dataTable">
      <thead>
        <tr>
          {{#each columns}}<th>{{this.column_name}}</th>{{/each}}
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr id="row-{{this.id}}">
            {{#each this}}
              <td>{{this}}</td>
            {{/each}}
            <td>
              <a href="/table/{{../tableName}}/rows/{{this.id}}"><button>Edit</button></a>
              <button class="delete-btn" onclick="deleteRow('{{this.id}}')">Delete</button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No matching rows found.</p>
  {{/if}}

  {{#if totalPages}}
  <div class="pagination">
    <div>
      Showing <strong>{{startRow}}</strong>–<strong>{{endRow}}</strong> of <strong>{{totalRows}}</strong>
    </div>
    <div>
      {{#if hasPrev}}
        <a href="/table/{{tableName}}?page={{sub currentPage 1}}&limit={{limit}}{{#if searchTerm}}&q={{searchTerm}}{{/if}}">
          <button>← Previous</button>
        </a>
      {{/if}}
      <span style="margin:0 15px; font-weight: bold;">Page {{currentPage}} of {{totalPages}}</span>
      {{#if hasNext}}
        <a href="/table/{{tableName}}?page={{add currentPage 1}}&limit={{limit}}{{#if searchTerm}}&q={{searchTerm}}{{/if}}">
          <button>Next →</button>
        </a>
      {{/if}}
    </div>
  </div>
  {{/if}}

<script>
  const TABLE_NAME = '{{tableName}}';

  async function insertRow() {
    const errEl = document.getElementById('insertError');
    errEl.style.display = 'none';

    const inputs = document.querySelectorAll('#insertForm [data-col]');
    const body = {};
    inputs.forEach(input => {
      if (input.value.trim() !== '') {
        body[input.dataset.col] = input.value.trim();
      }
    });

    if (Object.keys(body).length === 0) {
      errEl.textContent = 'Please fill in at least one field.';
      errEl.style.display = 'block';
      return;
    }

    const res = await fetch(`/table/${encodeURIComponent(TABLE_NAME)}/rows`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (!res.ok) {
      const data = await res.json();
      errEl.textContent = data.error || 'Insert failed.';
      errEl.style.display = 'block';
      return;
    }

    const newRow = await res.json();
    inputs.forEach(input => input.value = '');

    const tbody = document.querySelector('#dataTable tbody');
    if (tbody) {
      const cols = Array.from(inputs).map(i => i.dataset.col);
      const tr = document.createElement('tr');
      tr.id = `row-${newRow.id}`;
      tr.innerHTML = `<td>${newRow.id}</td>` +
        cols.map(col => `<td>${newRow[col] ?? ''}</td>`).join('') +
        `<td>
          <a href="/table/${encodeURIComponent(TABLE_NAME)}/rows/${newRow.id}"><button>Edit</button></a>
          <button class="delete-btn" onclick="deleteRow('${newRow.id}')">Delete</button>
        </td>`;
      tbody.appendChild(tr);
    }
  }

  async function deleteRow(id) {
    if (!confirm('Delete this row?')) return;

    const res = await fetch(
      `/table/${encodeURIComponent(TABLE_NAME)}/rows/${encodeURIComponent(id)}`,
      { method: 'DELETE' }
    );

    if (!res.ok) {
      const data = await res.json();
      alert(data.error || 'Delete failed.');
      return;
    }

    const row = document.getElementById(`row-${id}`);
    if (row) row.remove();
  }
</script>
</body>
</html>